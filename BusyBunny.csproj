<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BusyBunny</AssemblyName>
    <RootNamespace>BusyBunny</RootNamespace>
    <Product>Busy Bunny</Product>
    <AssemblyTitle>Busy Bunny</AssemblyTitle>
    <Version>0.13.0</Version>
    <ApplicationIcon Condition="Exists('native\BusyBunny.ico')">native\BusyBunny.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <StartupObject>BusyBunny.App</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>

    <!-- One self-contained file per architecture, so nothing else needs installing. WPF cannot be trimmed. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No compression (Morgan's issue 13): a compressed single file unpacks every library into memory
         at start, about 100 MB more. Uncompressed, Windows reads them straight from the exe. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Hand memory back sooner and compact the large-object heap, where the decoded sounds live. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Event sounds (Opus): native\Sounds-CREDITS.txt says where each comes from. -->
    <EmbeddedResource Include="native\sounds\*.opus">
      <LogicalName>snd.%(Filename).opus</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="native\Sounds-CREDITS.txt" LogicalName="Sounds-CREDITS.txt" />
    <EmbeddedResource Include="native\Concentus-LICENSE.txt" LogicalName="Concentus-LICENSE.txt" />
    <EmbeddedResource Include="CHANGES.txt" LogicalName="CHANGES.txt" />
    <!-- The content library (src\Engine\Content.cs): one plain text file per topic. -->
    <EmbeddedResource Include="src\Content\*.txt">
      <LogicalName>content.%(Filename).txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
