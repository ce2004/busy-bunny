<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BusyBunny</AssemblyName>
    <RootNamespace>BusyBunny</RootNamespace>
    <Product>Busy Bunny</Product>
    <AssemblyTitle>Busy Bunny</AssemblyTitle>
    <Version>0.2.2</Version>
    <ApplicationIcon Condition="Exists('native\BusyBunny.ico')">native\BusyBunny.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <StartupObject>BusyBunny.App</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>

    <!-- One self-contained file per architecture, so nothing else needs installing. WPF cannot be trimmed. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Event sounds (Opus): native\Sounds-CREDITS.txt says where each comes from. -->
    <EmbeddedResource Include="native\sounds\*.opus">
      <LogicalName>snd.%(Filename).opus</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="native\Sounds-CREDITS.txt" LogicalName="Sounds-CREDITS.txt" />
    <EmbeddedResource Include="native\Concentus-LICENSE.txt" LogicalName="Concentus-LICENSE.txt" />
    <EmbeddedResource Include="CHANGES.txt" LogicalName="CHANGES.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

</Project>
